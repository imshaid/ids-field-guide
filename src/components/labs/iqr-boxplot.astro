<div class="lab-iqr">
  <label class="f">Data — comma বা space দিয়ে আলাদা করো</label>
  <textarea rows="2" spellcheck="false">607, 630, 762, 685, 714, 561, 678, 662, 550, 901, 502, 725</textarea>
  <div class="btn-row" style="margin:.6rem 0 .2rem">
    <button class="btn sm ghost" data-p="607 630 762 685 714 561 678 662 550 901 502 725">Buildings (slide)</button>
    <button class="btn sm ghost" data-p="51 100 56 59 160 76 54 100 90 89 81 98 0 4 0">Saif Hasan · S'26</button>
    <button class="btn sm ghost" data-p="12 15 13 11 14 16 10 14 13 15 12 14 30 11">Tickets · F'25</button>
    <button class="btn sm ghost" data-p="26 37 24 28 35 22 31 53 41 64 29">Exercise · n=11</button>
    <button class="btn sm solid" data-run>Calculate ↵</button>
  </div>
  <div class="iqr-out">
    <label class="f" style="margin-top:.9rem">Sorted data — বাম অর্ধেক · median · ডান অর্ধেক</label>
    <div class="sorted"></div>
    <div class="stats"></div>
    <svg class="chart" viewBox="0 0 640 170" aria-label="Box plot"></svg>
    <p class="cap"></p>
    <div class="working">
      <label class="f">Exam working — খাতায় এভাবে লেখো</label>
      <ol></ol>
      <button class="btn sm ghost" data-copy="">Copy working</button>
    </div>
  </div>
</div>

<script>
  import { parseNums, quartiles, fmt, tween, lerp, el, inkIn, param, mean } from '../../scripts/stats';

  document.querySelectorAll<HTMLElement>('.lab-iqr').forEach((root) => {
    const ta = root.querySelector('textarea')!;
    const sortedEl = root.querySelector('.sorted')!;
    const statsEl = root.querySelector('.stats')!;
    const svg = root.querySelector('svg')!;
    const cap = root.querySelector('.cap')!;
    const ol = root.querySelector('.working ol')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    const fromUrl = param('data');
    if (fromUrl) ta.value = fromUrl.replace(/[_|]/g, ' ');

    // persistent SVG parts
    const W = 640, L = 40, R = 600, Y = 110;
    const axis = el('line', { x1: L, x2: R, y1: 150, y2: 150, class: 'axis' }, svg);
    const ticks = el('g', {}, svg);
    const whL = el('line', { y1: Y, y2: Y, stroke: 'var(--ink)', 'stroke-width': 1.4 }, svg);
    const whR = el('line', { y1: Y, y2: Y, stroke: 'var(--ink)', 'stroke-width': 1.4 }, svg);
    const capL = el('line', { y1: Y - 12, y2: Y + 12, stroke: 'var(--ink)', 'stroke-width': 1.4 }, svg);
    const capR = el('line', { y1: Y - 12, y2: Y + 12, stroke: 'var(--ink)', 'stroke-width': 1.4 }, svg);
    const box = el('rect', { y: Y - 22, height: 44, fill: 'var(--tint-2)', stroke: 'var(--ink)', 'stroke-width': 1.4 }, svg);
    const med = el('line', { y1: Y - 22, y2: Y + 22, stroke: 'var(--ink)', 'stroke-width': 3 }, svg);
    const fL = el('line', { y1: 20, y2: 140, stroke: 'var(--pen)', 'stroke-dasharray': '4 4' }, svg);
    const fR = el('line', { y1: 20, y2: 140, stroke: 'var(--pen)', 'stroke-dasharray': '4 4' }, svg);
    const fLt = el('text', { y: 16, 'text-anchor': 'middle', fill: 'var(--pen)' }, svg);
    const fRt = el('text', { y: 16, 'text-anchor': 'middle', fill: 'var(--pen)' }, svg);
    const dots = el('g', {}, svg);
    let prev: number[] | null = null;

    function run() {
      const data = parseNums(ta.value);
      if (data.length < 4) {
        cap.textContent = 'অন্তত ৪টা সংখ্যা দাও।';
        return;
      }
      const { s, lo, hi, q1, q2, q3 } = quartiles(data);
      const iqr = q3 - q1;
      const lf = q1 - 1.5 * iqr, uf = q3 + 1.5 * iqr;
      const outs = s.filter((x) => x < lf || x > uf);
      const inside = s.filter((x) => x >= lf && x <= uf);
      const wMin = Math.min(...inside), wMax = Math.max(...inside);
      const n = s.length;

      // sorted chips
      const m = n >> 1;
      sortedEl.innerHTML = s
        .map((x, i) => {
          let c = i < m ? 'lo' : n % 2 && i === m ? 'mid' : !(n % 2) && (i === m - 1 || i === m) ? 'mid' : '';
          if (x < lf || x > uf) c = 'out';
          const gap = n % 2 ? i === m || i === m + 1 : i === m;
          return (gap ? '<span class="gap"></span>' : '') + `<span class="${c}">${fmt(x)}</span>`;
        })
        .join('');
      inkIn(sortedEl.children);

      const items: [string, string, boolean?][] = [
        ['n', String(n)], ['Q1', fmt(q1)], ['Median (Q2)', fmt(q2)], ['Q3', fmt(q3)], ['IQR', fmt(iqr), true],
        ['Lower fence', fmt(lf)], ['Upper fence', fmt(uf)], ['Outlier', outs.length ? outs.map((x) => fmt(x)).join(', ') : 'নেই', true],
      ];
      statsEl.innerHTML = items.map(([k, v, h]) => `<div class="${h ? 'hl' : ''}"><small>${k}</small><strong>${v}</strong></div>`).join('');
      inkIn(statsEl.children);

      // scale
      const lo0 = Math.min(s[0], lf), hi0 = Math.max(s[n - 1], uf);
      const pad = (hi0 - lo0) * 0.04 || 1;
      const d0 = lo0 - pad, d1 = hi0 + pad;
      const X = (v: number) => L + ((v - d0) / (d1 - d0)) * (R - L);
      ticks.innerHTML = '';
      const step = niceStep((d1 - d0) / 6);
      for (let t = Math.ceil(d0 / step) * step; t <= d1; t += step) {
        el('line', { x1: X(t), x2: X(t), y1: 147, y2: 153, class: 'axis' }, ticks);
        el('text', { x: X(t), y: 166, 'text-anchor': 'middle' }, ticks).textContent = fmt(t);
      }
      const target = [X(wMin), X(q1), X(q2), X(q3), X(wMax), X(lf), X(uf)];
      const start = prev ?? target.map(() => X(q2));
      prev = target;
      fLt.textContent = `LF ${fmt(lf)}`;
      fRt.textContent = `UF ${fmt(uf)}`;
      tween(700, (k) => {
        const [a, b, c, d, e, f, g] = target.map((t, i) => lerp(start[i], t, k));
        whL.setAttribute('x1', String(a)); whL.setAttribute('x2', String(b));
        whR.setAttribute('x1', String(d)); whR.setAttribute('x2', String(e));
        capL.setAttribute('x1', String(a)); capL.setAttribute('x2', String(a));
        capR.setAttribute('x1', String(e)); capR.setAttribute('x2', String(e));
        box.setAttribute('x', String(b)); box.setAttribute('width', String(Math.max(0, d - b)));
        med.setAttribute('x1', String(c)); med.setAttribute('x2', String(c));
        fL.setAttribute('x1', String(f)); fL.setAttribute('x2', String(f)); fLt.setAttribute('x', String(f));
        fR.setAttribute('x1', String(g)); fR.setAttribute('x2', String(g)); fRt.setAttribute('x', String(g));
      });
      // dots with stacking for duplicates
      dots.innerHTML = '';
      const seen = new Map<number, number>();
      s.forEach((v, i) => {
        const k = seen.get(v) ?? 0;
        seen.set(v, k + 1);
        const isOut = v < lf || v > uf;
        const c = el('circle', { cx: X(v), cy: 62 - k * 9, r: 4, fill: isOut ? 'var(--pen)' : 'var(--ink)', opacity: 0 }, dots);
        setTimeout(() => c.setAttribute('opacity', '1'), 25 * i);
      });

      // caption
      cap.innerHTML = outs.length
        ? `Q1 = <b>${fmt(q1)}</b>, Q3 = <b>${fmt(q3)}</b>, তাই IQR = <b>${fmt(iqr)}</b>। Fence দুইটা ${fmt(lf)} আর ${fmt(uf)}। <b>${outs.map((x) => fmt(x)).join(', ')}</b> fence এর বাইরে — এগুলো outlier (লাল)। Box plot এ whisker থামে fence এর ভেতরের শেষ মানে।`
        : `Q1 = <b>${fmt(q1)}</b>, Q3 = <b>${fmt(q3)}</b>, IQR = <b>${fmt(iqr)}</b>। Fence ${fmt(lf)} থেকে ${fmt(uf)} — সব মান এর ভেতরে, তাই <b>কোনো outlier নেই</b>। ছোট বা বড় দেখালেও IQR rule অনুযায়ী সেগুলো "স্বাভাবিক বিস্তারের" মধ্যে।`;

      // working
      const steps = [
        `Sorted data (n = ${n}): ${s.map((x) => fmt(x)).join(', ')}`,
        n % 2
          ? `n odd, তাই median = ((n+1)/2)th = ${(n + 1) / 2}th value = ${fmt(q2)}`
          : `n even, তাই median = (${n / 2}th + ${n / 2 + 1}th)/2 = (${fmt(s[m - 1])} + ${fmt(s[m])})/2 = ${fmt(q2)}`,
        `Lower half: ${lo.map((x) => fmt(x)).join(', ')} → Q1 = ${fmt(q1)}`,
        `Upper half: ${hi.map((x) => fmt(x)).join(', ')} → Q3 = ${fmt(q3)}`,
        `IQR = Q3 − Q1 = ${fmt(q3)} − ${fmt(q1)} = ${fmt(iqr)}`,
        `Lower fence = Q1 − 1.5 × IQR = ${fmt(q1)} − ${fmt(1.5 * iqr)} = ${fmt(lf)}`,
        `Upper fence = Q3 + 1.5 × IQR = ${fmt(q3)} + ${fmt(1.5 * iqr)} = ${fmt(uf)}`,
        outs.length ? `Values outside [${fmt(lf)}, ${fmt(uf)}]: ${outs.map((x) => fmt(x)).join(', ')} → outlier(s).` : `No value lies outside [${fmt(lf)}, ${fmt(uf)}] → no outliers.`,
        `Mean = ${fmt(mean(s))}${outs.length ? `; outlier বাদে mean = ${fmt(mean(inside))}` : ''}`,
      ];
      ol.innerHTML = steps.map((t) => `<li>${t}</li>`).join('');
      inkIn(ol.children);
      copyBtn.dataset.copy = steps.map((t, i) => `${i + 1}. ${t}`).join('\n');
    }
    function niceStep(raw: number) {
      const p = Math.pow(10, Math.floor(Math.log10(raw)));
      const r = raw / p;
      return (r < 1.5 ? 1 : r < 3.5 ? 2 : r < 7.5 ? 5 : 10) * p;
    }
    root.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) =>
      b.addEventListener('click', () => {
        ta.value = b.dataset.p!.split(' ').join(', ');
        run();
      }),
    );
    root.querySelector('[data-run]')!.addEventListener('click', run);
    ta.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        run();
      }
    });
    run();
  });
</script>
