<div class="lab-shape">
  <div class="seg" data-mode style="margin-bottom:.8rem"><button data-v="skew" aria-pressed="true">Skewness</button><button data-v="kurt">Kurtosis</button><button data-v="emp">68–95–99.7</button></div>
  <div class="sh-ctrl"></div>
  <svg class="chart" viewBox="0 0 640 230" aria-label="Distribution shape"></svg>
  <div class="stats"></div>
  <p class="cap"></p>
</div>

<script>
  import { normPdf, normCdf, lnGamma, fmt, tween, lerp, el } from '../../scripts/stats';
  document.querySelectorAll<HTMLElement>('.lab-shape').forEach((root) => {
    const ctrl = root.querySelector('.sh-ctrl')!;
    const svg = root.querySelector('svg')!;
    const statsEl = root.querySelector('.stats')!;
    const cap = root.querySelector('.cap')!;
    const L = 30, R = 610, B = 190, H = 160, x0 = -4, x1 = 4;
    const X = (v: number) => L + ((v - x0) / (x1 - x0)) * (R - L);
    let mode = 'skew';
    let empK = 1, empCur = 1;

    function pathOf(f: (x: number) => number, ymax: number, close = false, a = x0, b = x1) {
      let d = '';
      const N = 140;
      for (let i = 0; i <= N; i++) { const v = a + ((b - a) * i) / N; d += `${i ? 'L' : 'M'}${X(v).toFixed(1)},${(B - (f(v) / ymax) * H).toFixed(1)}`; }
      return close ? `${d}L${X(b)},${B}L${X(a)},${B}Z` : d;
    }
    function base() {
      svg.innerHTML = '';
      el('line', { x1: L, x2: R, y1: B, y2: B, class: 'axis' }, svg);
    }
    function marker(x: number, color: string, label: string, y: number, dash = false) {
      el('line', { x1: X(x), x2: X(x), y1: y, y2: B, stroke: color, 'stroke-width': 2, 'stroke-dasharray': dash ? '4 3' : '' }, svg);
      el('text', { x: X(x) + 4, y: y + 2, fill: color }, svg).textContent = label;
    }
    // ---- skew ----
    function drawSkew(a: number) {
      base();
      const f = (x: number) => 2 * normPdf(x) * normCdf(a * x);
      let s = 0, m = 0, best = -1, mo = 0; const xs: number[] = [], cs: number[] = [];
      for (let i = 0; i <= 1600; i++) { const x = x0 + (8 * i) / 1600; const y = f(x); s += y; m += x * y; xs.push(x); cs.push(s); if (y > best) { best = y; mo = x; } }
      const mean = m / s, med = xs[cs.findIndex((c) => c >= s / 2)];
      const ymax = best * 1.12;
      el('path', { d: pathOf(f, ymax, true), fill: 'var(--tint-2)' }, svg);
      el('path', { d: pathOf(f, ymax), fill: 'none', stroke: 'var(--ink)', 'stroke-width': 2.2 }, svg);
      marker(mo, 'var(--ink-3)', 'mode', 20, true);
      marker(med, '#8a6f37', 'median', 44);
      marker(mean, 'var(--pen)', 'mean', 68);
      const kind = Math.abs(a) < 0.3 ? 'Symmetric' : a < 0 ? 'Negative (left) skew' : 'Positive (right) skew';
      statsEl.innerHTML = `<div class="hl"><small>Shape</small><strong>${kind}</strong></div><div><small>Mean</small><strong>${fmt(mean, 2)}</strong></div><div><small>Median</small><strong>${fmt(med, 2)}</strong></div><div><small>Mode</small><strong>${fmt(mo, 2)}</strong></div>`;
      cap.innerHTML = Math.abs(a) < 0.3
        ? 'দুই পাশ সমান, তাই mean = median = mode, একদম মাঝখানে। Slider টা বামে বা ডানে টানো।'
        : a < 0
          ? 'লম্বা লেজটা <b>বামে</b> — কয়েকটা খুব ছোট মান mean কে বামে টেনে নিয়েছে। তাই order টা: <b>mean &lt; median &lt; mode</b>। (Saif Hasan এর 0, 4, 0 ঠিক এই কাজটাই করে।)'
          : 'লম্বা লেজটা <b>ডানে</b> — কয়েকটা খুব বড় মান (যেমন বড়লোকের আয়) mean কে ডানে টানে। Order: <b>mode &lt; median &lt; mean</b>।';
    }
    // ---- kurtosis (generalized normal, unit variance) ----
    function drawKurt(beta: number) {
      base();
      const a = Math.sqrt(Math.exp(lnGamma(1 / beta) - lnGamma(3 / beta)));
      const f = (x: number) => (beta / (2 * a * Math.exp(lnGamma(1 / beta)))) * Math.exp(-Math.pow(Math.abs(x) / a, beta));
      const ex = Math.exp(lnGamma(5 / beta) + lnGamma(1 / beta) - 2 * lnGamma(3 / beta)) - 3;
      const ymax = 0.75;
      el('path', { d: pathOf(normPdf, ymax), fill: 'none', stroke: 'var(--ink-4)', 'stroke-width': 1.5, 'stroke-dasharray': '5 4' }, svg);
      el('path', { d: pathOf(f, ymax, true), fill: 'var(--tint-2)' }, svg);
      el('path', { d: pathOf(f, ymax), fill: 'none', stroke: 'var(--ink)', 'stroke-width': 2.2 }, svg);
      el('text', { x: X(1.9), y: B - normPdf(1.9) / ymax * H - 8, fill: 'var(--ink-3)' }, svg).textContent = '-- normal';
      const kind = Math.abs(ex) < 0.15 ? 'Mesokurtic' : ex > 0 ? 'Leptokurtic' : 'Platykurtic';
      statsEl.innerHTML = `<div class="hl"><small>Type</small><strong>${kind}</strong></div><div><small>Kurtosis</small><strong>${fmt(ex + 3, 2)}</strong></div><div><small>Excess (−3)</small><strong>${fmt(ex, 2)}</strong></div><div><small>Variance</small><strong>1 (fixed)</strong></div>`;
      cap.innerHTML = kind === 'Mesokurtic'
        ? 'এটাই normal curve: kurtosis = 3, excess = 0। Variance একই রেখে শুধু আকার বদলাচ্ছি — slider টানো।'
        : kind === 'Leptokurtic'
          ? 'চূড়া <b>সরু আর উঁচু</b>, লেজ <b>ভারী</b> — মানে বেশিরভাগ মান গড়ের খুব কাছে, কিন্তু মাঝে মাঝে অনেক extreme মান আসে। Kurtosis &gt; 3।'
          : 'চূড়া <b>চ্যাপ্টা</b>, লেজ <b>হালকা</b> — মানগুলো একটা range এ মোটামুটি সমানভাবে ছড়ানো, extreme মান কম। Kurtosis &lt; 3।';
    }
    // ---- empirical rule ----
    const P = (k: number) => (normCdf(k) - normCdf(-k)) * 100;
    function drawEmp(k: number) {
      base();
      const ymax = 0.45;
      el('path', { d: pathOf(normPdf, ymax, true, -k, k), fill: 'var(--tint-2)' }, svg);
      el('path', { d: pathOf(normPdf, ymax), fill: 'none', stroke: 'var(--ink)', 'stroke-width': 2.2 }, svg);
      [-3, -2, -1, 0, 1, 2, 3].forEach((z) => {
        el('line', { x1: X(z), x2: X(z), y1: B, y2: B + 6, class: 'axis' }, svg);
        el('text', { x: X(z), y: B + 20, 'text-anchor': 'middle' }, svg).textContent = z === 0 ? 'μ' : `${z > 0 ? '+' : ''}${z}σ`;
      });
      el('line', { x1: X(-k), x2: X(k), y1: 120, y2: 120, stroke: 'var(--ink)' }, svg);
      el('text', { x: X(0), y: 112, 'text-anchor': 'middle', fill: 'var(--ink)', style: 'font-size:15px;font-weight:600' }, svg).textContent = `${fmt(P(k), 2)}%`;
    }
    function controls() {
      if (mode === 'skew') {
        ctrl.innerHTML = '<label class="f">Skew — বামে টানো = negative, ডানে = positive</label><input type="range" min="-8" max="8" step="0.1" value="4">';
        const r = ctrl.querySelector('input')!;
        r.addEventListener('input', () => drawSkew(+r.value));
        drawSkew(4);
      } else if (mode === 'kurt') {
        ctrl.innerHTML = '<label class="f">Shape — বামে = সরু চূড়া (lepto), মাঝে = normal, ডানে = চ্যাপ্টা (platy)</label><input type="range" min="1" max="8" step="0.05" value="1.3">';
        const r = ctrl.querySelector('input')!;
        r.addEventListener('input', () => drawKurt(+r.value));
        drawKurt(1.3);
      } else {
        ctrl.innerHTML = '<div class="seg"><button data-k="1" aria-pressed="true">±1σ</button><button data-k="2">±2σ</button><button data-k="3">±3σ</button></div>';
        ctrl.querySelectorAll<HTMLButtonElement>('[data-k]').forEach((b) => b.addEventListener('click', () => {
          ctrl.querySelectorAll('[data-k]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          const from = empCur;
          empK = +b.dataset.k!;
          tween(700, (t) => { empCur = lerp(from, empK, t); drawEmp(empCur); });
          setEmpText();
        }));
        empCur = empK = 1;
        drawEmp(1);
        setEmpText();
      }
    }
    function setEmpText() {
      const t: Record<number, string> = { 1: '68%', 2: '95%', 3: '99.7%' };
      statsEl.innerHTML = `<div class="hl"><small>Range</small><strong>μ ± ${empK}σ</strong></div><div><small>Data এর ভেতরে</small><strong>≈ ${t[empK]}</strong></div><div><small>বাইরে</small><strong>≈ ${fmt(100 - P(empK), 1)}%</strong></div>`;
      cap.innerHTML = empK === 1
        ? 'গড় থেকে ১ SD এর মধ্যে প্রায় <b>68%</b> data। ধরো ক্লাসের গড় নম্বর 70, SD 10 — তাহলে প্রায় 68% student 60 থেকে 80 এর মধ্যে।'
        : empK === 2
          ? '±2 SD এর মধ্যে প্রায় <b>95%</b>। ওই উদাহরণে 50 থেকে 90 এর মধ্যে প্রায় সবাই — 5% এর মত বাইরে।'
          : '±3 SD এর মধ্যে <b>99.7%</b> — এর বাইরে কিছু থাকলে সেটা খুবই অস্বাভাবিক, প্রায় outlier।';
    }
    root.querySelectorAll<HTMLButtonElement>('[data-mode] button').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-mode] button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      mode = b.dataset.v!;
      controls();
    }));
    controls();
  });
</script>
