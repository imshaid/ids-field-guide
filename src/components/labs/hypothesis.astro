<div class="lab-hyp">
  <div class="btn-row" style="margin-bottom:.8rem">
    <button class="btn sm ghost" data-p="s24">Coding issue · S'24 Q1</button>
    <button class="btn sm ghost" data-p="z1">z example 1 (slide)</button>
    <button class="btn sm ghost" data-p="z2">z example 2 (slide)</button>
    <button class="btn sm ghost" data-p="t1">t example (slide)</button>
  </div>
  <div class="row">
    <div><label class="f">Claim μ₀</label><input type="number" data-k="mu" step="any" /></div>
    <div><label class="f">Sample mean x̄</label><input type="number" data-k="x" step="any" /></div>
    <div><label class="f">n</label><input type="number" data-k="n" min="2" step="1" /></div>
    <div><label class="f">SD</label><input type="number" data-k="sd" step="any" min="0" /></div>
  </div>
  <div class="row">
    <div><label class="f">SD টা কার?</label><select data-k="kind"><option value="z">Population σ (জানা) → z</option><option value="t">Sample s (σ অজানা) → t</option></select></div>
    <div><label class="f">Ha (alternative)</label><select data-k="tail"><option value="two">μ ≠ μ₀ (two-tail)</option><option value="left">μ &lt; μ₀ (left-tail)</option><option value="right">μ &gt; μ₀ (right-tail)</option></select></div>
    <div><label class="f">α (significance)</label><select data-k="alpha"><option>0.10</option><option>0.05</option><option>0.025</option><option>0.02</option><option>0.01</option></select></div>
  </div>
  <svg class="chart" viewBox="0 0 640 220" aria-label="Distribution with rejection region"></svg>
  <div class="hyp-legend kicker" style="margin:.3rem 0 .6rem"><span style="color:var(--pen)">▨ rejection region (α)</span> &nbsp; <span>■ p-value area</span> &nbsp; <span>│ তোমার test statistic</span></div>
  <ol class="hyp-steps"></ol>
  <p class="cap"></p>
  <button class="btn sm ghost" data-copy="">Copy exam working</button>
</div>

<style is:global>
  .hyp-steps { list-style: none; padding: 0; margin: 0.6rem 0 0; counter-reset: s; }
  .hyp-steps li { counter-increment: s; display: grid; grid-template-columns: 4.6rem 1fr; gap: 0.8rem; padding: 0.7rem 0; border-top: 1px solid var(--rule); font-size: 0.93rem; }
  .hyp-steps li::before { content: 'Step ' counter(s); font: 500 0.66rem/1.6 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .hyp-steps .verdict { font-weight: 650; }
  .hyp-steps .verdict.rej { color: var(--pen); }
</style>

<script>
  import { normPdf, normCdf, normInv, tPdf, tCdf, tInv, fmt, fmtP, tween, lerp, el, inkIn, param } from '../../scripts/stats';
  type S = { mu: number; x: number; n: number; sd: number; kind: string; tail: string; alpha: string };
  const PRE: Record<string, S> = {
    s24: { mu: 120, x: 115, n: 25, sd: 10, kind: 'z', tail: 'two', alpha: '0.02' },
    z1: { mu: 90, x: 85, n: 20, sd: 7, kind: 'z', tail: 'two', alpha: '0.01' },
    z2: { mu: 300000, x: 288000, n: 25, sd: 80000, kind: 'z', tail: 'left', alpha: '0.025' },
    t1: { mu: 36.7, x: 40.6, n: 15, sd: 6, kind: 't', tail: 'right', alpha: '0.05' },
  };
  document.querySelectorAll<HTMLElement>('.lab-hyp').forEach((root) => {
    const svg = root.querySelector('svg')!;
    const steps = root.querySelector('.hyp-steps')!;
    const cap = root.querySelector('.cap')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    const inp = (k: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`)!;
    let prevStat = 0;
    function set(s: S) { for (const [k, v] of Object.entries(s)) inp(k).value = String(v); }
    function get(): S { return { mu: +inp('mu').value, x: +inp('x').value, n: Math.round(+inp('n').value), sd: +inp('sd').value, kind: inp('kind').value, tail: inp('tail').value, alpha: inp('alpha').value }; }

    function run() {
      const s = get();
      if (!(s.n >= 2 && s.sd > 0)) { cap.textContent = 'n ≥ 2 আর SD > 0 দাও।'; return; }
      const a = Number(s.alpha);
      const isT = s.kind === 't';
      const df = s.n - 1;
      const se = s.sd / Math.sqrt(s.n);
      const stat = (s.x - s.mu) / se;
      const cdf = (v: number) => (isT ? tCdf(v, df) : normCdf(v));
      const pdf = (v: number) => (isT ? tPdf(v, df) : normPdf(v));
      const inv = (p: number) => (isT ? tInv(p, df) : normInv(p));
      const p = s.tail === 'two' ? 2 * (1 - cdf(Math.abs(stat))) : s.tail === 'left' ? cdf(stat) : 1 - cdf(stat);
      const crit = s.tail === 'two' ? inv(1 - a / 2) : s.tail === 'left' ? inv(a) : inv(1 - a);
      const reject = p < a;
      const sym = isT ? 't' : 'z';
      const h0op = s.tail === 'two' ? '=' : s.tail === 'left' ? '≥' : '≤';
      const haop = s.tail === 'two' ? '≠' : s.tail === 'left' ? '<' : '>';

      // chart
      svg.innerHTML = '';
      const lim = Math.max(4, Math.min(8, Math.abs(stat) + 0.8));
      const L = 30, R = 610, B = 180, H = 150;
      const X = (v: number) => L + ((v + lim) / (2 * lim)) * (R - L);
      const ymax = pdf(0) * 1.08;
      const Y = (v: number) => B - (pdf(v) / ymax) * H;
      const path = (x0: number, x1: number, close: boolean) => {
        let d = '';
        const N = 80;
        for (let i = 0; i <= N; i++) { const v = x0 + ((x1 - x0) * i) / N; d += `${i ? 'L' : 'M'}${X(v).toFixed(1)},${Y(v).toFixed(1)}`; }
        return close ? `${d}L${X(x1)},${B}L${X(x0)},${B}Z` : d;
      };
      const defs = el('defs', {}, svg);
      const pat = el('pattern', { id: 'hatch-' + root.dataset.uid, width: 6, height: 6, patternUnits: 'userSpaceOnUse', patternTransform: 'rotate(45)' }, defs);
      el('line', { x1: 0, y1: 0, x2: 0, y2: 6, stroke: 'var(--pen)', 'stroke-width': 2.2 }, pat);
      const hatch = `url(#hatch-${root.dataset.uid})`;
      const rej: [number, number][] = s.tail === 'two' ? [[-lim, -crit], [crit, lim]] : s.tail === 'left' ? [[-lim, crit]] : [[crit, lim]];
      rej.forEach(([u, v]) => el('path', { d: path(u, v, true), fill: hatch, opacity: 0.85 }, svg));
      const pa: [number, number][] = s.tail === 'two' ? [[-lim, -Math.abs(stat)], [Math.abs(stat), lim]] : s.tail === 'left' ? [[-lim, Math.min(stat, lim)]] : [[Math.max(stat, -lim), lim]];
      pa.forEach(([u, v]) => { if (v > u) el('path', { d: path(u, v, true), fill: 'var(--ink)', opacity: 0.22 }, svg); });
      el('path', { d: path(-lim, lim, false), fill: 'none', stroke: 'var(--ink)', 'stroke-width': 2 }, svg);
      el('line', { x1: L, x2: R, y1: B, y2: B, class: 'axis' }, svg);
      for (let v = -Math.floor(lim); v <= Math.floor(lim); v++) el('text', { x: X(v), y: B + 16, 'text-anchor': 'middle' }, svg).textContent = String(v);
      (s.tail === 'two' ? [-crit, crit] : [crit]).forEach((c) => {
        el('line', { x1: X(c), x2: X(c), y1: Y(c) - 4, y2: B, stroke: 'var(--pen)', 'stroke-width': 1.4 }, svg);
        el('text', { x: X(c), y: B + 32, 'text-anchor': 'middle', fill: 'var(--pen)' }, svg).textContent = `crit ${fmt(c, 3)}`;
      });
      const mk = el('g', {}, svg);
      el('line', { x1: 0, x2: 0, y1: 18, y2: B, stroke: reject ? 'var(--pen)' : 'var(--ink)', 'stroke-width': 3 }, mk);
      el('text', { x: 6, y: 16, fill: reject ? 'var(--pen)' : 'var(--ink)' }, mk).textContent = `${sym} = ${fmt(stat, 3)}`;
      const from = prevStat;
      prevStat = stat;
      tween(900, (k) => mk.setAttribute('transform', `translate(${X(Math.max(-lim, Math.min(lim, lerp(from, stat, k))))},0)`));

      // steps
      const pLine = s.tail === 'two' ? `p = 2 × P(${sym} > |${fmt(stat, 3)}|) = ${fmtP(p)}` : s.tail === 'left' ? `p = P(${sym} < ${fmt(stat, 3)}) = ${fmtP(p)}` : `p = P(${sym} > ${fmt(stat, 3)}) = ${fmtP(p)}`;
      const L4 = [
        `H₀: μ ${h0op} ${s.mu}  vs  Hₐ: μ ${haop} ${s.mu}  (${s.tail === 'two' ? 'two-tailed' : s.tail + '-tailed'} test, α = ${a})`,
        isT ? `Population σ জানা নেই, শুধু sample SD s = ${s.sd} → t-distribution, df = n − 1 = ${df}` : `Population σ = ${s.sd} জানা (population normal ধরে) → z-distribution`,
        `${sym} = (x̄ − μ₀)/(${isT ? 's' : 'σ'}/√n) = (${s.x} − ${s.mu})/(${s.sd}/√${s.n}) = ${fmt(s.x - s.mu, 4)}/${fmt(se, 4)} = ${fmt(stat, 3)};  ${pLine}`,
        reject ? `p = ${fmtP(p)} < α = ${a} → Reject H₀. (${s.tail === 'two' ? `|${sym}| = ${fmt(Math.abs(stat), 3)} > ${fmt(crit, 3)}` : `${sym} falls beyond critical value ${fmt(crit, 3)}`})` : `p = ${fmtP(p)} ≥ α = ${a} → Fail to reject H₀. (${sym} is not in the rejection region)`,
      ];
      steps.innerHTML = L4.map((t, i) => `<li>${i === 3 ? `<span class="verdict ${reject ? 'rej' : ''}">${t}</span>` : t}</li>`).join('');
      inkIn(steps.children);
      cap.innerHTML = reject
        ? `Test statistic টা লাল দাগানো rejection region এর ভেতরে পড়েছে — H₀ সত্য হলে এমন sample পাওয়ার সম্ভাবনা মাত্র ${fmtP(p)}, যেটা α (${a}) এর চেয়ে কম। তাই বলবো: population mean যে ${s.mu} ${s.tail === 'two' ? 'থেকে আলাদা' : s.tail === 'left' ? 'এর চেয়ে কম' : 'এর চেয়ে বেশি'}, তার যথেষ্ট প্রমাণ আছে। (সাবধান: এতে Type I error এর ঝুঁকি α = ${a})`
        : `Statistic টা rejection region এর বাইরে। p = ${fmtP(p)} ≥ α, তাই H₀ reject করার মত যথেষ্ট প্রমাণ নেই। মনে রাখো: এর মানে H₀ "প্রমাণিত সত্য" না — শুধু data দিয়ে বাতিল করা গেল না। (এখানে ঝুঁকি Type II error)`;
      copy.dataset.copy = L4.map((t, i) => `Step ${i + 1}: ${t}`).join('\n');
    }
    root.dataset.uid = Math.random().toString(36).slice(2, 7);
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-p]');
      if (b) { set(PRE[b.dataset.p!]); run(); }
    });
    root.querySelectorAll('input, select').forEach((i) => i.addEventListener('change', run));
    root.querySelectorAll('input').forEach((i) => i.addEventListener('input', run));
    const preset = param('preset');
    set(PRE[preset && PRE[preset] ? preset : 's24']);
    run();
  });
</script>
