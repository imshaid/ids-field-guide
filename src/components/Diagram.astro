---
// Build-time SVG diagrams. Label widths are planned for IBM Plex Mono
// (advance = 0.6em): 12px -> 7.2px/char, 12.5px bold -> 7.5px, 11px -> 6.6px.
// Animation hooks: .fx = fade/scale in, .dr = stroke draw (needs pathLength=1),
// --i = order in the sequence (110ms per step). See site.ts for the trigger.
interface Props { name: string; caption?: string }
const { name, caption } = Astro.props;

const phi = (x: number) => Math.exp(-0.5 * x * x) / Math.sqrt(2 * Math.PI);
const Phi = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
function erf(x: number) {
  const s = Math.sign(x); x = Math.abs(x);
  const t = 1 / (1 + 0.3275911 * x);
  const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
  return s * y;
}
function curve(f: (x: number) => number, x0: number, x1: number, W: number, H: number, ox: number, oy: number, ymax: number) {
  const pts: string[] = [];
  const N = 90;
  for (let i = 0; i <= N; i++) {
    const x = x0 + ((x1 - x0) * i) / N;
    const px = ox + (W * i) / N;
    const py = oy + H - (H * f(x)) / ymax;
    pts.push(`${i ? 'L' : 'M'}${px.toFixed(1)},${py.toFixed(1)}`);
  }
  return pts.join('');
}
function stats(f: (x: number) => number, x0: number, x1: number) {
  const N = 2000; let s = 0, m = 0, best = -1, mode = 0; const xs: number[] = []; const cs: number[] = [];
  for (let i = 0; i <= N; i++) { const x = x0 + ((x1 - x0) * i) / N; const y = f(x); s += y; m += x * y; xs.push(x); cs.push(s); if (y > best) { best = y; mode = x; } }
  const mean = m / s; const half = s / 2; const med = xs[cs.findIndex((c) => c >= half)];
  return { mean, med, mode };
}
const sk = (a: number) => (x: number) => 2 * phi(x) * Phi(a * x);
const skewSets = [
  { a: -5, label: 'Negative skew', note: 'লম্বা লেজ বামে' },
  { a: 0, label: 'Symmetric', note: 'দুই পাশ সমান' },
  { a: 5, label: 'Positive skew', note: 'লম্বা লেজ ডানে' },
].map((s, i) => {
  const f = sk(s.a); const ox = 20 + i * 220; const W = 190, H = 110, oy = 40;
  const st = stats(f, -3.2, 3.2); const X = (x: number) => ox + ((x + 3.2) / 6.4) * W;
  return { ...s, d: curve(f, -3.2, 3.2, W, H, ox, oy, 0.85), ox, W, H, oy, mean: X(st.mean), med: X(st.med), mode: X(st.mode) };
});
const kurt = [
  { cls: 'k1', label: 'Leptokurtic', note: 'সরু চূড়া, ভারী লেজ', f: (x: number) => 0.5 * Math.exp(-Math.abs(x)) },
  { cls: 'k2', label: 'Mesokurtic', note: 'normal', f: (x: number) => phi(x) },
  { cls: 'k3', label: 'Platykurtic', note: 'চ্যাপ্টা চূড়া', f: (x: number) => 0.27 * Math.exp(-Math.pow(Math.abs(x) / 1.9, 4)) },
].map((k) => ({ ...k, d: curve(k.f, -4, 4, 560, 150, 40, 30, 0.52) }));
const normalD = curve(phi, -3.6, 3.6, 560, 170, 40, 20, 0.42);
const NX = (z: number) => 40 + ((z + 3.6) / 7.2) * 560;

// process7: snake layout, 4 on top (left->right), 3 below (right->left)
const P7 = ['Business|problem', 'Data|acquisition', 'Data|preparation', 'Explore|(EDA)', 'Model &|evaluate', 'Communicate|results', 'Deploy &|maintain'];
const BW = 132, BH = 62, COL = (c: number) => 22 + c * 168;
const p7 = P7.map((l, i) => ({ lines: l.split('|'), x: i < 4 ? COL(i) : COL(7 - i), y: i < 4 ? 24 : 150 }));

// pop-sample: population dots, 7 of them are drawn into the sample
const pop = Array.from({ length: 46 }, (_, i) => {
  const a = i * 2.4; const r = 12 + ((i * 37) % 78);
  return { x: 170 + Math.cos(a) * r, y: 112 + Math.sin(a) * r, pick: i % 7 === 0, c: ['f-w1', 'f-w2', 'f-w3', 'f-w4'][i % 4] };
});
const picked = pop.filter((d) => d.pick).map((d, k) => {
  const sx = 446 + (k % 4) * 17; const sy = 100 + Math.floor(k / 4) * 22;
  return { sx, sy, dx: d.x - sx, dy: d.y - sy };
});

const steps: Record<string, number> = { 'ai-ml-ds': 4, process7: 15, dikw: 6, venn: 5, 'sampling-tree': 8, 'pop-sample': 6, boxplot: 6, skew: 5, kurtosis: 5, empirical: 7, decision: 7 };
const D = (i: number) => `--i:${i}`;
---
<figure class={`dg dg-${name} anim`} data-steps={steps[name] ?? 8}>
{name === 'ai-ml-ds' && (
  <svg viewBox="0 0 680 320" role="img" aria-label="AI, Machine Learning আর Data Science এর সম্পর্ক">
    <g style={D(0)}>
      <circle cx="200" cy="165" r="145" class="fx f-paper s-ink" />
      <text x="200" y="62" text-anchor="middle" class="t-b">Artificial Intelligence</text>
      <text x="200" y="84" text-anchor="middle" class="t-s">Vision · Robotics · Planning</text>
    </g>
    <g style={D(1)}>
      <circle cx="215" cy="200" r="80" class="fx f-w1 s-ink" style="--fo:.42" />
      <text x="195" y="180" text-anchor="middle" class="t-b">Machine</text>
      <text x="195" y="196" text-anchor="middle" class="t-b">Learning</text>
      <text x="195" y="218" text-anchor="middle" class="t-s">kNN · Trees</text>
      <text x="195" y="233" text-anchor="middle" class="t-s">Naive Bayes</text>
      <text x="195" y="248" text-anchor="middle" class="t-s">Deep learning</text>
    </g>
    <g style={D(2)}>
      <rect x="255" y="112" width="405" height="186" class="fx f-w3 s-ink rr" style="--fo:.34" />
      <text x="365" y="146" class="t-b">Data Science</text>
      <text x="365" y="176">Statistics · Visualization</text>
      <text x="365" y="200">Data preparation</text>
      <text x="365" y="224">Experimentation</text>
      <text x="365" y="248">Business understanding</text>
    </g>
  </svg>
)}
{name === 'process7' && (
  <svg viewBox="0 0 680 252" role="img" aria-label="Data science এর ৭টা ধাপ">
    <defs><marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="f-inkonly" /></marker></defs>
    {p7.map((b, i) => (
      <g style={D(i * 2)}>
        <rect x={b.x} y={b.y} width={BW} height={BH} class={`fx ${i === 0 ? 'f-ink' : 'f-paper s-ink'}`} />
        <text x={b.x + 12} y={b.y + 18} class={i === 0 ? 't-inv t-s' : 't-s t-num'}>{String(i + 1).padStart(2, '0')}</text>
        {b.lines.map((l, j) => <text x={b.x + 12} y={b.y + 37 + j * 15} class={i === 0 ? 't-inv' : 't-ink'}>{l}</text>)}
      </g>
    ))}
    {p7.slice(0, 6).map((b, i) => {
      const n = p7[i + 1];
      const d = i < 3 ? `M${b.x + BW + 3},${b.y + BH / 2} H${n.x - 4}` : i === 3 ? `M${b.x + BW / 2},${b.y + BH + 3} V${n.y - 4}` : `M${b.x - 3},${b.y + BH / 2} H${n.x + BW + 4}`;
      return <path d={d} class="s-ink dr" pathLength="1" marker-end="url(#ah)" style={D(i * 2 + 1)} />;
    })}
    <path d={`M${COL(1) - 3},181 H88 V${24 + BH + 4}`} class="s-mute dash fx" marker-end="url(#ah)" style={D(13)} />
    <text x="22" y="240" class="t-s" style={D(14)}>↺ iterative: দরকার হলে আগের ধাপে ফেরা যায়</text>
  </svg>
)}
{name === 'dikw' && (
  <svg viewBox="0 0 680 290" role="img" aria-label="DIKW pyramid">
    <g style={D(0)}>
      <polygon points="190,270 530,270 500.2,228 219.8,228" class="fx f-w1" style="--fo:.32" />
      <text x="360" y="254" text-anchor="middle" class="t-b">DATA</text>
      <text x="189" y="254" text-anchor="end" class="t-s">raw fact</text>
      <text x="531" y="254">"100"</text>
    </g>
    <g style={D(1)}>
      <polygon points="221.9,225 498.1,225 462,174 258,174" class="fx f-w1" style="--fo:.5" />
      <text x="360" y="204" text-anchor="middle" class="t-b">INFORMATION</text>
      <text x="225" y="204" text-anchor="end" class="t-s">+ context</text>
      <text x="495" y="204">"100 miles"</text>
    </g>
    <g style={D(2)}>
      <polygon points="260.1,171 459.9,171 423.8,120 296.3,120" class="fx f-w1" style="--fo:.72" />
      <text x="360" y="150" text-anchor="middle" class="t-b">KNOWLEDGE</text>
      <text x="263" y="150" text-anchor="end" class="t-s">+ meaning</text>
      <text x="457" y="150">"100 miles অনেক দূর"</text>
    </g>
    <g style={D(3)}>
      <polygon points="298.4,117 421.6,117 360,30" class="fx f-ink" />
      <text x="360" y="100" text-anchor="middle" class="t-b t-inv">WISDOM</text>
      <text x="302" y="95" text-anchor="end" class="t-s">+ judgment</text>
      <text x="418" y="95">"হেঁটে না, গাড়িতে যাও"</text>
    </g>
  </svg>
)}
{name === 'venn' && (
  <svg viewBox="0 0 640 330" role="img" aria-label="Data science venn diagram">
    <circle cx="260" cy="125" r="105" class="fx f-w4 s-soft" style="--fo:.32;--i:0" />
    <circle cx="380" cy="125" r="105" class="fx f-w2 s-soft" style="--fo:.32;--i:1" />
    <circle cx="320" cy="215" r="105" class="fx f-w1 s-soft" style="--fo:.32;--i:2" />
    <g style={D(0)}><text x="215" y="100" text-anchor="middle" class="t-b">Computer</text><text x="215" y="116" text-anchor="middle" class="t-b">Science</text></g>
    <g style={D(1)}><text x="425" y="100" text-anchor="middle" class="t-b">Maths &amp;</text><text x="425" y="116" text-anchor="middle" class="t-b">Statistics</text></g>
    <g style={D(2)}><text x="320" y="292" text-anchor="middle" class="t-b">Business / Domain</text><text x="320" y="308" text-anchor="middle" class="t-b">expertise</text></g>
    <g style={D(3)}>
      <text x="320" y="74" text-anchor="middle" class="t-s">Machine</text><text x="320" y="88" text-anchor="middle" class="t-s">learning</text>
      <text x="262" y="204" text-anchor="middle" class="t-s">Traditional</text><text x="262" y="218" text-anchor="middle" class="t-s">software</text>
      <text x="378" y="204" text-anchor="middle" class="t-s">Data</text><text x="378" y="218" text-anchor="middle" class="t-s">analysis</text>
    </g>
    <g style={D(4)}>
      <rect x="276" y="137" width="88" height="40" class="fx f-ink" />
      <text x="320" y="153" text-anchor="middle" class="t-inv t-s">DATA</text><text x="320" y="168" text-anchor="middle" class="t-inv t-s">SCIENCE</text>
    </g>
  </svg>
)}
{name === 'sampling-tree' && (
  <svg viewBox="0 0 640 246" role="img" aria-label="Sampling methods tree">
    <g style={D(0)}><rect x="240" y="10" width="160" height="36" class="fx f-ink" /><text x="320" y="33" text-anchor="middle" class="t-inv t-b">Sampling methods</text></g>
    <path d="M320,46 V64 M160,64 H480 M160,64 V84 M480,64 V84" class="s-ink dr" pathLength="1" style={D(1)} />
    <g style={D(2)}><rect x="60" y="84" width="200" height="36" class="fx f-w3 s-ink" style="--fo:.45" /><text x="160" y="107" text-anchor="middle" class="t-b">Probability (random)</text></g>
    <g style={D(2)}><rect x="380" y="84" width="200" height="36" class="fx f-paper s-ink" /><text x="480" y="107" text-anchor="middle" class="t-b">Non-probability</text></g>
    {['Simple random', 'Stratified', 'Cluster (one/two-stage)', 'Systematic'].map((s, i) => (<g style={D(3 + i)}><path d={`M80,120 V${147 + i * 27} H94`} class="s-mute dr" pathLength="1" /><text x="100" y={151 + i * 27}>{s}</text></g>))}
    {['Judgmental', 'Snowball', 'Convenience', 'Quota'].map((s, i) => (<g style={D(3 + i)}><path d={`M400,120 V${147 + i * 27} H414`} class="s-mute dr" pathLength="1" /><text x="420" y={151 + i * 27}>{s}</text></g>))}
  </svg>
)}
{name === 'pop-sample' && (
  <svg viewBox="0 0 640 232" role="img" aria-label="Population থেকে sample">
    <defs><marker id="ah2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="f-inkonly" /></marker></defs>
    <circle cx="170" cy="112" r="95" class="fx f-paper s-ink" style={D(0)} />
    <g style={D(1)}>{pop.map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="4.5" class={`fx ${d.pick ? 'f-ink' : d.c}`} />)}</g>
    <path d="M272,112 H405" class="s-ink dr" pathLength="1" marker-end="url(#ah2)" style={D(2)} />
    <text x="338" y="102" text-anchor="middle" class="t-s" style={D(2)}>random draw</text>
    <circle cx="471" cy="112" r="55" class="fx f-paper s-ink dash" style={D(3)} />
    {picked.map((p, k) => <circle cx={p.sx} cy={p.sy} r="5" class="f-ink fly" style={`--dx:${p.dx.toFixed(1)}px;--dy:${p.dy.toFixed(1)}px;--i:${4 + k * 0.35}`} />)}
    <text x="170" y="226" text-anchor="middle" class="t-b" style={D(0)}>Population (N)</text>
    <text x="471" y="192" text-anchor="middle" class="t-b" style={D(3)}>Sample (n)</text>
  </svg>
)}
{name === 'boxplot' && (
  <svg viewBox="0 0 640 214" role="img" aria-label="Box plot এর অংশগুলো">
    <path d="M70,100 H200 M430,100 H540 M70,85 V115 M540,85 V115" class="s-ink dr" pathLength="1" style={D(0)} />
    <rect x="200" y="70" width="230" height="60" class="fx f-w3 s-ink" style="--fo:.35;--i:1" />
    <path d="M300,70 V130" class="s-ink thick dr" pathLength="1" style={D(2)} />
    <circle cx="606" cy="100" r="6" class="fx f-pen" style={D(3)} />
    <g style={D(3)} class="t-s">
      <path d="M200,46 V66 M300,46 V66 M430,46 V66" class="s-mute" />
      <text x="200" y="40" text-anchor="middle" class="t-s">Q1</text>
      <text x="300" y="40" text-anchor="middle" class="t-s">Median (Q2)</text>
      <text x="430" y="40" text-anchor="middle" class="t-s">Q3</text>
      <path d="M70,120 V142 M540,120 V142 M606,110 V142" class="s-mute" />
      <text x="70" y="156" text-anchor="middle" class="t-s">Min</text>
      <text x="540" y="156" text-anchor="middle" class="t-s">Max</text>
      <text x="606" y="156" text-anchor="middle" class="t-s c-pen">Outlier</text>
    </g>
    <path d="M200,174 V180 H430 V174" class="s-ink dr" pathLength="1" style={D(4)} />
    <text x="315" y="200" text-anchor="middle" class="t-s" style={D(5)}>IQR = Q3 − Q1 (মাঝের 50%)</text>
  </svg>
)}
{name === 'skew' && (
  <svg viewBox="0 0 680 214" role="img" aria-label="Negative, symmetric আর positive skew">
    <g class="legend" style={D(0)}>
      <path d="M20,16 H40" class="s-mute dash" /><text x="46" y="20" class="t-s">mode</text>
      <path d="M100,16 H120" class="s-w3" /><text x="126" y="20" class="t-s">median</text>
      <path d="M192,16 H212" class="s-pen" /><text x="218" y="20" class="t-s">mean</text>
    </g>
    {skewSets.map((s, i) => (<g style={D(i + 1)}>
      <path d={`M${s.ox},${s.oy + s.H} H${s.ox + s.W}`} class="s-ink" />
      <path d={s.d} class="s-ink thick f-none dr" pathLength="1" />
      <path d={`M${s.mode},${s.oy} V${s.oy + s.H}`} class="s-mute dash fx" />
      <path d={`M${s.med},${s.oy + 25} V${s.oy + s.H}`} class="s-w3 fx" />
      <path d={`M${s.mean},${s.oy + 45} V${s.oy + s.H}`} class="s-pen fx" />
      <text x={s.ox} y={s.oy + s.H + 24} class="t-b">{s.label}</text>
      <text x={s.ox} y={s.oy + s.H + 42} class="t-s">{s.note}</text>
    </g>))}
  </svg>
)}
{name === 'kurtosis' && (
  <svg viewBox="0 0 640 214" role="img" aria-label="Kurtosis এর তিন রকম">
    <path d="M40,180 H600" class="s-ink" />
    {kurt.map((k, i) => (<g style={D(i)}>
      <path d={k.d} class={`f-none dr ${k.cls}`} pathLength="1" />
      <path d={`M40,${14 + i * 18} H62`} class={k.cls} />
      <text x="70" y={18 + i * 18} class="t-s"><tspan class="t-ink">{k.label}</tspan> — {k.note}</text>
    </g>))}
    <text x="320" y="200" text-anchor="middle" class="t-s" style={D(3)}>একই center, ভিন্ন চূড়া আর লেজ</text>
  </svg>
)}
{name === 'empirical' && (
  <svg viewBox="0 0 640 230" role="img" aria-label="68-95-99.7 rule">
    <path d={`${normalD} L600,190 L40,190 Z`} class="fx f-w4" style="--fo:.18;--i:0" />
    <path d={normalD} class="s-ink thick f-none dr" pathLength="1" style={D(0)} />
    {[-3, -2, -1, 0, 1, 2, 3].map((z) => (<g style={D(1)}><path d={`M${NX(z)},40 V190`} class={`fx ${z === 0 ? 's-ink' : 's-mute dash'}`} /><text x={NX(z)} y="208" text-anchor="middle" class="t-s">{z === 0 ? 'μ' : `${z > 0 ? '+' : '−'}${Math.abs(z)}σ`}</text></g>))}
    {[[1, 120, '68%'], [2, 152, '95%'], [3, 178, '99.7%']].map(([k, y, l], i) => (<g style={D(2 + i)}>
      <path d={`M${NX(-Number(k))},${Number(y) - 5} V${Number(y) + 5} M${NX(-Number(k))},${y} H${NX(Number(k))} M${NX(Number(k))},${Number(y) - 5} V${Number(y) + 5}`} class="s-ink dr" pathLength="1" />
      <rect x={NX(0) - 26} y={Number(y) - 17} width="52" height="14" class="fx f-tag" />
      <text x={NX(0)} y={Number(y) - 6} text-anchor="middle" class="t-b">{l}</text>
    </g>))}
  </svg>
)}
{name === 'decision' && (
  <svg viewBox="0 0 640 170" role="img" aria-label="p-value দিয়ে decision">
    <defs><marker id="ah3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="f-inkonly" /></marker></defs>
    <g style={D(0)}><rect x="20" y="55" width="150" height="50" class="fx f-ink" /><text x="34" y="76" class="t-inv t-b">p-value বের করো</text><text x="34" y="93" class="t-inv t-s">table / software</text></g>
    <path d="M170,80 H218" class="s-ink dr" pathLength="1" marker-end="url(#ah3)" style={D(1)} />
    <g style={D(2)}><polygon points="300,30 380,80 300,130 220,80" class="fx f-paper s-ink" /><text x="300" y="84" text-anchor="middle" class="t-b">p &lt; α ?</text></g>
    <path d="M380,80 H420 V40 H438 M420,80 V120 H438" class="s-ink dr" pathLength="1" style={D(3)} />
    <g style={D(3)}><text x="388" y="70" class="t-s">yes</text><text x="388" y="112" class="t-s">no</text></g>
    <g style={D(4)}><rect x="440" y="18" width="185" height="44" class="fx f-pen" /><text x="452" y="37" class="t-inv t-b">হ্যাঁ → Reject H0</text><text x="452" y="53" class="t-inv t-s">Ha এর পক্ষে প্রমাণ আছে</text></g>
    <g style={D(5)}><rect x="440" y="98" width="185" height="44" class="fx f-paper s-ink" /><text x="452" y="117" class="t-b">না → Fail to reject H0</text><text x="452" y="133" class="t-s">যথেষ্ট প্রমাণ নেই</text></g>
  </svg>
)}
{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .dg { margin: 1.6em 0; padding: 0.9rem 0.6rem 0.5rem; border: 1px solid var(--rule); border-radius: var(--r); background: var(--sheet); }
  .dg svg { width: 100%; height: auto; display: block; overflow: visible; }
