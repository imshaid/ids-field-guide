---
import Base from '../layouts/Base.astro';
---
<Base title="Page নেই" crumbs={[{ label: '404' }]}>
  <div class="page">
    <div class="col">
      <div class="kicker">404</div>
      <h1 class="display">এই page টা খুঁজে পাওয়া যায়নি</h1>
      <p class="lead">Link টা হয়তো বদলে গেছে। উপরের § চাপলে পুরো contents পাবে, বা <code>/</code> চেপে search করো।</p>
      <a class="btn solid" href="/">Cover এ ফিরে যাও</a>
    </div>
  </div>
</Base>
